# Linux/WSL use the same config JSON. Copy to .env.local and use LOCAL paths.
# Paths containing spaces are supported. Environment files are never published.
RVECTR_DATA_ROOT="${HOME}/Videos/rvectr"
RVECTR_MODELS_DIR="${HOME}/.local/share/rvectr/models"
RVECTR_OUTPUT_ROOT="outputs"
# Optional; defaults to <RVECTR_DATA_ROOT>/calibration
# RVECTR_CALIBRATION_DIR="${HOME}/Videos/rvectr/calibration"
